# Copy this to .env and fill in your values. NEVER commit .env.
# If WATSONX_API_KEY / WATSONX_PROJECT_ID are absent, the app runs in Demo Mode.

# IBM watsonx.ai credentials (both key names are supported)
WATSONX_API_KEY=your_api_key_here
# WATSONX_APIKEY=your_api_key_here     ← alternative name, also supported

WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Set to "true" to force Demo Mode even when credentials are present
COSM_DEMO_MODE=false
